{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode (Playwright transpiles specs; nothing is emitted) */
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* The shared e2e config, the seed/screenshot scripts and the two node
       scripts behind `npm run build` / `npm run preview` are plain ESM .mjs
       (run directly by node, outside any TS build) — check them here too,
       via their JSDoc types. The build and preview scripts belong in this
       project rather than a fourth one: the e2e suite is what runs them. */
    "allowJs": true,
    "checkJs": true,

    /* Node globals (fs, process, Buffer) used by helpers and fixtures */
    "types": ["node"],

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "e2e/**/*.ts",
    "e2e/**/*.mjs",
    "scripts/**/*.mjs",
    "playwright.config.ts"
  ]
}
