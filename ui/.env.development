# Plain `npm run dev` targets the fully local stack: the API on
# localhost:3000 and the seeded local S3 bucket from docker-compose.yml —
# same targets as .env.test, so a bare vite dev server never silently
# reads the real AWS test bucket (issue #246). To develop against the
# real test bucket, run `./scripts/dev.sh --aws`, which overrides
# VITE_S3_URL via the environment (real env vars beat this file).
# `./scripts/dev.sh` also overrides both URLs with its stack's actual
# ports when the defaults are taken (issue #220).
VITE_API_URL=http://localhost:3000
VITE_S3_URL=http://localhost:9000/kari-e2e

# Sign the admin app in automatically instead of going through Auth0
# (#266), so `npm run dev:admin` / `./scripts/dev.sh` need no credentials.
# The API accepts the matching dev token only when it was built with the
# `dev-auth` cargo feature and KARI_DEV_AUTH=1 is set — dev.sh does both.
# Never set in .env, .env.staging or .env.production: the deployed bundles
# must not contain the fake at all. Real env vars beat this file, so
# `VITE_AUTH_MODE=auth0 ./scripts/dev.sh` gives you the real Auth0 login.
VITE_AUTH_MODE=fake
