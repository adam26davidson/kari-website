# Plain `npm run dev` targets the fully local stack: the API on
# localhost:3000 and the seeded MinIO bucket from docker-compose.yml —
# same targets as .env.test, so a bare vite dev server never silently
# reads the real AWS test bucket (issue #246). To develop against the
# real test bucket, run `./scripts/dev.sh --aws`, which overrides
# VITE_S3_URL via the environment (real env vars beat this file).
# `./scripts/dev.sh` also overrides both URLs with its stack's actual
# ports when the defaults are taken (issue #220).
VITE_API_URL=http://localhost:3000
VITE_S3_URL=http://localhost:9000/kari-e2e
