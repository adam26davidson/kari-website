{
  // Type-checks the unit/component tests (and, via their imports, the app
  // code they exercise). Kept as a separate project from tsconfig.app.json
  // because test files import vitest, whose types pull in Node's — and the
  // app project deliberately keeps Node globals out of browser code
  // ("types": [] there). Vitest runs the tests in Node, so Node types are
  // correct here.
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  // vite-bundle-budget.ts is build tooling, type-checked by
  // tsconfig.node.json alongside vite.config.ts. It is listed here too so
  // its test in the config project may import it: a composite project has
  // to list every file in its program.
  "include": [
    "apps/*/src",
    "packages/*/src",
    "test",
    "vite-bundle-budget.ts"
  ]
}
