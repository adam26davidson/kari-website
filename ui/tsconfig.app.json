{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    // Browser code: keep Node globals (process, Buffer, ...) out of the
    // program even though @types/node is installed for configs/e2e, so
    // accidental Node API usage in app code fails the build instead of
    // crashing in the browser. Vite's client types still load via the ///
    // reference in vite-env.d.ts. Test files are excluded below (checked by
    // tsconfig.test.json instead) because importing vitest would pull Node
    // types back in transitively.
    "types": [],

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  // Every workspace's browser code. The shared package is consumed as
  // TypeScript source (see packages/shared/package.json), so it belongs in
  // the same program as the apps that import it rather than behind a build
  // step of its own.
  "include": ["apps/*/src", "packages/*/src"],
  // `packages/*/src/test/**` is test infrastructure, not browser code: only
  // *.test.* files import it, and it touches process.env. It has to be
  // excluded here for the same reason the test files themselves are --
  // "types": [] above leaves Node globals undeclared. Until vitest 4 it got
  // away with being in this program, because vitest 2's types referenced
  // Node's and so declared `process` transitively for anything importing
  // vitest; vitest 4 stopped doing that, which surfaced it (#529).
  // tsconfig.test.json includes packages/*/src in full, so these files are
  // still type-checked -- there, with Node types, which is where they run.
  // Excluding a file only drops it as a ROOT of this program: if browser
  // code ever imports it, TypeScript pulls it back in and the missing
  // `process` fails the build again, which is the guard working.
  "exclude": ["**/*.test.ts", "**/*.test.tsx", "packages/*/src/test/**"]
}
