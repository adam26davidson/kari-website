# Deployed test environment (test.karidavidson.com). Served by the same EC2
# instance as prod: nginx proxies /api to the test API process, which reads
# from the test content bucket. Auth0 values come from .env (shared tenant).
VITE_API_URL=/api
VITE_S3_URL=https://s3.us-east-2.amazonaws.com/test.karidavidson.com

# Staging-only: registers the admin "What's on test" deployment-status
# section (/admin/whats-on-test)
# (never set in .env.production, so the prod bundle drops it).
VITE_SHOW_TEST_STATUS=true
