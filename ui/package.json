{
  "name": "kari-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "vite --config apps/public/vite.config.ts",
    "dev:admin": "vite --config apps/admin/vite.config.ts",
    "build": "tsc -b && node scripts/build-apps.mjs",
    "build:staging": "tsc -b && node scripts/build-apps.mjs staging",
    "build:test": "tsc -b && node scripts/build-apps.mjs test",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "preview": "node scripts/serve.mjs",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "npm run typecheck && vitest run --coverage",
    "test:e2e": "node e2e/seed.mjs && playwright test",
    "typecheck": "tsc -b",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1136.0",
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^30.1.0",
    "prettier": "^3.9.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "allowScripts": {
    "@fortawesome/fontawesome-common-types": false,
    "@fortawesome/fontawesome-svg-core": false,
    "@fortawesome/free-solid-svg-icons": false,
    "@swc/core": false,
    "browser-tabs-lock": false
  },
  "overrides": {
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  }
}
