VITE_API_URL=http://localhost:3000
VITE_S3_URL=http://localhost:9000/kari-e2e
# Same Auth0 tenant as production for now (matches the previously hardcoded
# values); this is the place to point test builds at a different tenant.
VITE_AUTH0_DOMAIN=dev-ivkddn8ec0pdwd5a.us.auth0.com
VITE_AUTH0_CLIENT_ID=gEuLXgSWSpVoqjJSv5gs5qb2a83Tz0JM
VITE_AUTH0_AUDIENCE=https://api.karidavidson.com/

# Registers the admin /admin/whats-on-test section in the e2e/test-mode
# bundle so it can
# be exercised and screenshotted locally and in CI. VITE_COMMIT_SHA stays
# unset here, so the page shows its deterministic "unknown build" fallback
# instead of calling the live GitHub API from tests — which is what the
# visual-review workflow's build wants, since e2e/screenshots.mjs mocks
# nothing. The playwright run builds its own bundle with a fake head sha
# (E2E_COMMIT_SHA in playwright.config.ts) so admin-whats-on-test.spec.ts
# can drive the deployed-build states with every request intercepted.
VITE_SHOW_TEST_STATUS=true

# The e2e/screenshot bundle signs itself in rather than logging into Auth0
# (#266), so admin journeys and admin captures run without
# E2E_AUTH0_USERNAME / E2E_AUTH0_PASSWORD. Never set in .env, .env.staging
# or .env.production. e2e/admin-auth0-login.spec.ts opts this bundle back
# into the real Auth0 flow at runtime (a localStorage key) for the one
# journey that must keep exercising it.
VITE_AUTH_MODE=fake
