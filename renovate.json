{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits"
  ],
  "timezone": "America/New_York",
  "schedule": ["on monday"],
  "labels": ["dependencies"],
  "prConcurrentLimit": 5,
  "rangeStrategy": "bump",
  "customManagers": [
    {
      "description": [
        "Track the docker images pinned in shell scripts (issue #327).",
        "No built-in manager reads shell scripts, so pins like",
        "ACTIONLINT_IMAGE=\"${ACTIONLINT_IMAGE:-rhysd/actionlint:1.7.12}\"",
        "would rot while everything else auto-updates. The",
        "'# renovate: datasource=docker' comment on the line above is what",
        "this matches; scripts/lint-workflows.sh fails the build if a pin",
        "is missing one, so a new pin cannot silently escape this manager."
      ],
      "customType": "regex",
      "managerFilePatterns": ["/^scripts/.*\\.sh$/", "/^automation/.*\\.sh$/"],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s*\\n\\s*\\w+=\"?\\$?\\{?(?:\\w+:-)?(?<depName>[^:\"\\s}]+):(?<currentValue>[^\"\\s}]+)\\}?\"?"
      ]
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": ["on monday"]
  },
  "packageRules": [
    {
      "description": "Auto-merge non-major updates once CI passes",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true
    },
    {
      "description": "Require manual review for major updates",
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "addLabels": ["major-update"]
    },
    {
      "description": "Group the TipTap editor packages",
      "matchPackageNames": ["@tiptap/**"],
      "groupName": "tiptap"
    },
    {
      "description": "Group React core and its type definitions",
      "matchPackageNames": [
        "react",
        "react-dom",
        "@types/react",
        "@types/react-dom"
      ],
      "groupName": "react"
    },
    {
      "description": "Group ESLint and its plugins",
      "matchPackageNames": ["*eslint*", "@typescript-eslint/**"],
      "groupName": "eslint"
    },
    {
      "description": "Group the JS/TS test tooling",
      "matchPackageNames": [
        "vitest",
        "@vitest/**",
        "@testing-library/**",
        "@playwright/test",
        "jsdom"
      ],
      "groupName": "test tooling"
    },
    {
      "description": "Group the AWS Rust SDK crates",
      "matchManagers": ["cargo"],
      "matchPackageNames": ["/^aws-/", "/^aws_/"],
      "groupName": "aws sdk (rust)"
    }
  ]
}
