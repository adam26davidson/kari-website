# Local development / e2e target: a throwaway MinIO started with
#   docker run -d --rm --name kari-e2e-s3 -p 9000:9000 \
#     -e MINIO_ROOT_USER=kari-e2e -e MINIO_ROOT_PASSWORD=kari-e2e-secret \
#     minio/minio server /data
# and seeded by `node e2e/seed.mjs` in ui/ (npm run test:e2e does this).
# To run against a real AWS bucket instead, unset AWS_ENDPOINT_URL and use
# real credentials (aws sso login).
BUCKET_NAME=kari-e2e
AWS_ENDPOINT_URL=http://localhost:9000
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=kari-e2e
AWS_SECRET_ACCESS_KEY=kari-e2e-secret
