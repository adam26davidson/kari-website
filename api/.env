# Local development / e2e target: a throwaway local S3 (RustFS) started with
#   docker compose up -d --wait s3   (from the repo root)
# on its default host port 9000, and seeded by `node e2e/seed.mjs` in ui/
# (npm run test:e2e does this). If the local S3 was published on a non-default
# port (scripts/dev.sh does that when 9000 is taken), adjust
# AWS_ENDPOINT_URL accordingly — dev.sh exports the right value itself and
# never reads this file.
# To run against a real AWS bucket instead, unset AWS_ENDPOINT_URL and use
# real credentials (aws sso login).
BUCKET_NAME=kari-e2e
AWS_ENDPOINT_URL=http://localhost:9000
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=kari-e2e
AWS_SECRET_ACCESS_KEY=kari-e2e-secret

# The local development auth bypass (#266). Only meaningful in a binary
# built with the `dev-auth` cargo feature (`cargo run --features dev-auth`);
# a default build ignores it entirely, which is what the deployed binary is.
# With both in place the API additionally accepts the static
# `kari-dev-auth-token` bearer as an admin, so the admin UI, the e2e admin
# journeys and the screenshot capture need no Auth0 credentials. Real Auth0
# JWTs keep working exactly as before.
KARI_DEV_AUTH=1
